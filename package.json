{
  "name": "dtf-uv-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:cloud": "node server/index.cjs",
    "start": "python3 -m http.server 3000 --bind 0.0.0.0",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "dev:montadora": "vite --config montadora-src/vite.config.mts --host 0.0.0.0",
    "build": "tsc -p montadora-src/tsconfig.json && vite build --config montadora-src/vite.config.mts",
    "prestart": "npm run build",
    "pretest:e2e": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "maxrects-packer": "^2.7.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5"
  }
}
